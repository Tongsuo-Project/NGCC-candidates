CC=/usr/bin/gcc
CFLAGS += -Wno-incompatible-pointer-types -mavx2 -mpopcnt -mbmi2 -msse2 -march=native -mtune=native -O3 -fomit-frame-pointer -std=c99

SPEED_TARGETS = speed-nev-512-1409-sha3
KAT_TARGETS = PQCgenKAT_kem-nev-512-1409-iccs

all: $(SPEED_TARGETS) $(KAT_TARGETS)

SOURCES = poly.c  ntt.c owpke.c  verify.c sample.c pack.c

KEM = cca.c cpa.c

HEADERS = params.h poly.h ntt.h owpke.h verify.h api.h randombytes.h kat_test/KEM_AlgorithmInstance.h align.h sample.h

